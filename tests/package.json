{
  "name": "@rtc/tests",
  "version": "0.0.0",
  "private": true,
  "imports": {
    "#/*": "./*"
  },
  "type": "module",
  "scripts": {
    "clean": "rm -rf .turbo reports coverage 2>/dev/null || true",
    "clean:deep": "pnpm run clean && (rm -rf node_modules 2>/dev/null || true)",
    "coverage:report": "node scripts/coverage-report.ts",
    "gates": "node scripts/grep-gates.ts",
    "jarvis:smoke:live": "node scripts/jarvis-live-smoke.ts",
    "perf:framework-compare": "node scripts/framework-compare.ts",
    "perf:motion-audit": "node scripts/with-server.ts node scripts/motion-audit.ts",
    "perf:motion-audit:solid": "RTC_CLIENT_PKG=@rtc/client-solid node scripts/with-server.ts node scripts/motion-audit.ts",
    "port:free": "node scripts/free-port.ts",
    "test:browser:playwright": "node scripts/with-server.ts playwright test --config browser/playwright/playwright.config.ts",
    "test:browser:playwright-cucumber": "NODE_OPTIONS='--import tsx/esm' node scripts/with-server.ts cucumber-js --config browser/playwright-cucumber/cucumber.mts",
    "test:browser:playwright-cucumber:headed": "PWCUCUMBER_HEADED=1 NODE_OPTIONS='--import tsx/esm' node scripts/with-server.ts cucumber-js --config browser/playwright-cucumber/cucumber.mts",
    "test:browser:playwright-cucumber:solid": "RTC_CLIENT_PKG=@rtc/client-solid NODE_OPTIONS='--import tsx/esm' node scripts/with-server.ts cucumber-js --config browser/playwright-cucumber/cucumber.mts",
    "test:browser:playwright:headed": "node scripts/with-server.ts playwright test --headed --config browser/playwright/playwright.config.ts",
    "test:browser:playwright:solid": "RTC_CLIENT_PKG=@rtc/client-solid node scripts/with-server.ts playwright test --config browser/playwright/playwright.config.ts",
    "test:browser:playwright:ui": "node scripts/with-server.ts playwright test --ui --config browser/playwright/playwright.config.ts",
    "test:e2e": "pnpm gates && node scripts/run-all.ts",
    "test:fullstack:browser": "node fullstack/browser-smoke.ts",
    "test:fullstack:browser:headed": "FULLSTACK_HEADED=1 node fullstack/browser-smoke.ts",
    "test:fullstack:hybrid": "node fullstack/hybrid-smoke.ts",
    "test:fullstack:hybrid:headed": "FULLSTACK_HEADED=1 node fullstack/hybrid-smoke.ts",
    "test:fullstack:node": "tsx fullstack/node-smoke.ts",
    "test:hooks": "vitest run browser/playwright-cucumber",
    "test:pages": "vitest run scripts/pages",
    "test:presenter:cucumber-fake-timers": "NODE_OPTIONS='--import tsx/esm' cucumber-js --config presenter/cucumber-fake-timers/cucumber.mts",
    "test:presenter:vitest-fake-timers": "vitest run --config presenter/vitest-fake-timers/vitest.config.ts",
    "test:report": "vitest run scripts/lib",
    "typecheck": "tsc --noEmit",
    "visual:jitter": "node scripts/visual-jitter.ts",
    "visual:engine-parity": "node scripts/visual-engine-parity.ts"
  },
  "dependencies": {
    "@rtc/client-core": "workspace:*",
    "@rtc/client-react": "workspace:*",
    "@rtc/domain": "workspace:*",
    "@rtc/server": "workspace:*",
    "@rtc/shared": "workspace:*",
    "rxjs": "^7.8",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.60.0",
    "@sinonjs/fake-timers": "^15.0.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/ui": "^5.0.3",
    "istanbul-lib-coverage": "^3.2.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
