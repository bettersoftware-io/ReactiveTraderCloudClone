{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/reports",
      "!**/coverage",
      "!**/__screenshots__",
      "!**/*.png",
      "!**/.turbo",
      "!**/*.json5",
      "!pnpm-lock.yaml",
      // Design-artifact prototype (hand-authored HUD redesign mock). Not
      // production code — "shares no code with the real app" per its README —
      // so it is out of scope for the formatter/linter, like dist/reports.
      "!docs/design",
      // Self-contained showcase artifacts — single-file HTML generated on the
      // fly to visualize a doc (inline CSS/JS by design). Not production code;
      // out of scope for the formatter/linter, same rationale as docs/design.
      // The dir's README.md stays in scope — only the generated HTML is excluded.
      "!docs/showcase/**/*.html",
      // Exported presentation decks — single-file HTML (2–4 MiB, fonts and
      // images inlined), the same kind of artifact as docs/showcase. Past
      // biome's 1 MiB cap they were skipped anyway, as a warning.
      "!docs/presentations/**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            // Sort bare/side-effect imports (e.g. `import "./index.css"`) too.
            "sortBareImports": true,
            // Groups match in array order — earlier matchers win. Negations
            // (`!`) carve overlaps out of predefined groups: `:PACKAGE:` minus
            // `@rtc/**` keeps workspace packages out of third-party (so react
            // sorts before @rtc/*, which gets its own group); `:PATH:` minus
            // `:STYLE:` lets CSS fall through to a real, last :STYLE: group.
            // :BLANK_LINE: inserts a blank line. Within :PATH:, imports sort by
            // distance (more `../` first, `./` last), then natural order.
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              [":PACKAGE:", "!@rtc/**"],
              ":BLANK_LINE:",
              "@rtc/**",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              [":PATH:", "!:STYLE:"],
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        }
        // Sorters triaged 2026-06-22 — deferred, decide & address later:
        // "useSortedKeys": "on"        // ~1116 hits, mostly fixtures + *.contract.spec.ts (conflicts with "specs MUST NOT change")
        // "useSortedAttributes": "on"  // ~128 JSX attribute reorders
        // "useSortedProperties": "on"  // ~134 CSS property reorders (cascade risk; visual goldens are the oracle)
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended",
      "project": "recommended",
      "turborepo": "recommended",
      "types": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useUniqueElementIds": "error"
      },
      "style": {
        "useComponentExportOnlyModules": "error",
        // `recommended` ships noNonNullAssertion as a warning; a `!` non-null
        // assertion silently defeats the type checker, so we make it a hard
        // error to match the repo's zero-findings / no-disables policy. Prefer
        // an explicit narrowing guard (`if (x === undefined) throw …`).
        "noNonNullAssertion": "error",
        // A statement that names ONLY types is spelled `import type { … }` /
        // `export type { … }`. Under `verbatimModuleSyntax` the inline form
        // (`import { type A }`) survives as a runtime import of the module,
        // which could pull a lazy application core into the eager bundle.
        // `recommended` ships both as warnings; they are errors here so a
        // plain `pnpm lint` fails too, not only CI's `--error-on-warnings`.
        // The other half — one statement per module — is ESLint's
        // `rtc/one-import-per-module`.
        "useImportType": "error",
        "useExportType": "error",
        // Always require braces on control statements (if/else/for/while/…).
        // Bans the brace-less single-statement form (`if (x) doThis();`) so
        // every branch body is a block — cheaper diffs when a second statement
        // is added, and no dangling-else / goto-fail ambiguity. Fixable: Biome
        // rewrites the brace-less form on `check --write`.
        "useBlockStatements": "error",
        // Force named exports everywhere we control: default exports are
        // un-discoverable by editors, invite inconsistent local names, and
        // their CJS/ESM default-import interop is fragile (a default import of
        // a named-only module silently broke under a Cypress bump). Tool config
        // files (vite/vitest/playwright/cypress/eslint/stylelint) MUST default-
        // export, so they're scoped out in `overrides` below.
        "noDefaultExport": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../../**"],
                "message": "Imports may go at most one level up (\"../\"). For anything deeper use the #/ alias (or #tests/ in client-react tests). Built libs rewrite #/ to relative at build time via tsc-alias."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noLeakedRender": "error",
        "noUndeclaredEnvVars": "error"
      },
      "nursery": {
        // Require explicit types everywhere the inference would otherwise be
        // implicit: function/method return types, parameters, and variables.
        // Self-documents call sites and speeds up tsc. This is a `nursery`
        // (not-yet-stable) rule — the ONLY nursery rule we opt into — so its
        // semantics may shift on a Biome upgrade; revisit on each bump.
        "useExplicitType": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    }
  },
  "markdown": {
    // Biome 2.6 formats Markdown by default. The docs are hand-wrapped prose
    // with mermaid diagrams and tables laid out for GitHub's column width
    // (CLAUDE.md "Markdown Diagrams"); a reflow would rewrite ~500 files for
    // no reader benefit. Their gate is `pnpm check:doc-links` (every relative
    // link + anchor), not a formatter. Only the formatter is off: the
    // Markdown linter stays on.
    "formatter": {
      "enabled": false
    }
  },
  "overrides": [
    {
      // The three nodenext-resolution tsc-built libs import relative modules
      // WITH the .js extension (domain/shared are already 100%
      // consistent; motion-core was 46-vs-5 with the 5 all in test files).
      // This pins the convention so extensionless strays can't creep back in
      // via test files, where vitest resolves either form and nothing else
      // complains. The bundler-resolution packages (client-*, devtools-*,
      // ui-contract, boot-splash) are deliberately extensionless and stay
      // out of scope.
      "includes": [
        "packages/domain/**",
        "packages/shared/**",
        "packages/motion-core/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": {
              "level": "error",
              "options": { "forceJsExtensions": true }
            }
          }
        }
      }
    },
    {
      "includes": ["**/tsconfig*.json"],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    },
    {
      // Framework config + ambient declaration files are required to use a
      // default export (vite/vitest/playwright/cypress/eslint/stylelint configs,
      // cucumber-js profile configs, `*.d.ts` module declarations). They are the
      // ONLY place default exports are allowed — application and test code must
      // use named exports.
      "includes": [
        "**/*.config.*",
        "**/cucumber.mts",
        ".dependency-cruiser.mts",
        "**/*.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Expo Router routes are framework entry-points: the file-based router
      // discovers each screen by its DEFAULT export, so `app/**` is a scoped
      // exception to the repo-wide noDefaultExport policy.
      "includes": ["packages/client-react-native/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // The equities chart plot follows the WAI-ARIA APG "application" widget
      // pattern: the container itself carries role="application" +
      // tabIndex={0} so it is the one focusable element, then owns ALL
      // keyboard handling internally (arrow-key pan, +/-/Home/End zoom —
      // useChartGestures) rather than exposing a tab stop per interactive
      // child. `role="application"` isn't in aria-query's "widget" role
      // subtree, so noNoninteractiveTabindex (mirroring jsx-a11y) flags it as
      // a false positive for this specific, deliberate pattern. Scoped to the
      // extracted, purely presentational `ChartPlot` (the plot div's actual
      // owner post-Task-C5-fix — `CandleChart` itself no longer renders any
      // DOM) across every web client (React today; the Solid port lands at
      // the analogous path under client-solid).
      "includes": ["packages/client-*/src/ui/equities/chart/ChartPlot.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noNoninteractiveTabindex": "off"
          }
        }
      }
    },
    {
      // The chart navigator strip is `role="group"` — WAI-ARIA's generic
      // grouping role for related UI elements (here: the mini-map polyline
      // plus its draggable window/handles) that are NOT a form's fieldset.
      // useSemanticElements' `<fieldset>` suggestion only fits form-control
      // grouping, so it's a false positive for this non-form widget. Task
      // 7's contract spec keys on the literal role="group" + aria-label
      // strings, so the markup can't change to satisfy the rule. Scoped to
      // `NavigatorStrip.tsx` across every web client (React today; the Solid
      // port lands at the analogous path under client-solid).
      "includes": [
        "packages/client-*/src/ui/equities/chart/NavigatorStrip.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      // Power-saver FREEZE is implemented as a global CSS catch-all: a
      // `[data-power-saver="freeze"] *` block that collapses every
      // animation/transition in the app to nothing. `!important` is what makes
      // it a catch-all rather than a suggestion — it has to outrank arbitrary
      // author-level animations it knows nothing about, including third-party
      // CSS (Dockview's), so specificity alone cannot do the job. Biome's
      // noImportantStyles fix is to DELETE the `!important`, which would
      // silently reduce freeze to "whatever happens to lose the cascade" — the
      // freeze contract's `transition-property` check would catch it, but only
      // after the guarantee had already been broken. Scoped to the two web
      // clients' root stylesheets, the only place the catch-all lives.
      "includes": ["packages/client-*/src/index.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      // noComponentHookFactories (Biome 2.6) guards against a component or
      // hook built inside a function that runs on every render: each render
      // then mints a new component type and React remounts the subtree. Both
      // places below build them in a function that runs ONCE, never per render:
      //
      // - `createViewModel` IS the ViewModel seam (docs/adr/ADR-004): it turns
      //   presenters + machines + commands into the hook bundle the UI reads
      //   through `useViewModel()`, closing over the core it was given. It runs
      //   once per AppRoot mount (packages/client-react/src/AppRoot.tsx), so
      //   every hook in the bundle keeps one identity for the core's lifetime.
      // - Test harnesses (page objects, contract fakes, `renderHook` probes and
      //   wrappers) declare their Probe/Harness/Wrapper inside the factory or
      //   `mount()` that closes over its arguments, called once per mount and
      //   never during a render. Hoisting them to module scope is not an
      //   option: a module-level component in a module that exports a page
      //   factory is a `useComponentExportOnlyModules` error (re-checked on
      //   2.6.8), which is why the harnesses nest them in the first place.
      "includes": [
        "packages/react-bindings/src/createViewModel.ts",
        "packages/*/tests/**",
        "packages/*/src/**/*.test.tsx"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      // useDomNodeTextContent (Biome 2.6) targets the DOM property
      // `Node.innerText`. Every hit here is Playwright's `Locator.innerText()`
      // instead — a different API that only shares the name. The page objects
      // read it on purpose: it is the text as RENDERED (CSS text-transform
      // applied, hidden nodes skipped), which is what a user sees and what the
      // specs assert. `Locator.textContent()` would return the raw source text
      // and `string | null`, changing what the assertions compare.
      "includes": ["tests/browser/page-objects/playwright/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    },
    {
      // noReactNativeRawText (Biome 2.6, reactNative domain) only knows the
      // built-in text containers. `SectionLabel` renders its `children: string`
      // inside a `<Text>`, so a string child is not raw text; `skip` is the
      // rule's own option for exactly such wrappers. Scoped to the RN client so
      // naming the level here cannot switch the rule on for the web clients.
      "includes": ["packages/client-react-native/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": { "skip": ["SectionLabel"] }
            }
          }
        }
      }
    }
  ]
}
