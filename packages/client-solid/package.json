{
  "name": "@rtc/client-solid",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.ui-contract.json && tsc --noEmit -p tsconfig.ui-visual.json",
    "test": "vitest run",
    "test:ui:contract": "vitest run -c tests/ui/contract/vitest.config.ts",
    "test:app:coverage": "vitest run src/app -c vitest.app.coverage.config.ts --coverage",
    "test:ui:contract:coverage": "vitest run -c tests/ui/contract/vitest.coverage.config.ts --coverage",
    "test:ui:styles": "vitest run -c tests/ui/visual/vitest-browser/vitest-browser.config.ts coreSwapOverlay",
    "test:ui:visual": "node tests/ui/visual/run-all.ts",
    "test:ui:visual:solid": "node tests/ui/visual/run-all.ts solid",
    "test:ui:visual:playwright:solid": "playwright test -c tests/ui/visual/playwright/playwright.config.ts",
    "test:ui:visual:playwright:solid:ui": "playwright test -c tests/ui/visual/playwright/playwright.config.ts --ui",
    "test:ui:visual:vitest-browser:solid:coverage": "vitest run -c tests/ui/visual/vitest-browser/vitest-browser.coverage.config.ts --coverage",
    "dev": "vite",
    "clean": "(rm -rf dist .turbo *.tsbuildinfo reports coverage .vitest-attachments 2>/dev/null || true)",
    "clean:deep": "pnpm run clean && (rm -rf node_modules 2>/dev/null || true)"
  },
  "dependencies": {
    "@rtc/boot-splash": "workspace:*",
    "@rtc/core-api": "workspace:*",
    "@rtc/core-logic": "workspace:*",
    "@rtc/domain": "workspace:*",
    "@rtc/layout-dockview": "workspace:*",
    "@rtc/motion-core": "workspace:*",
    "@rtc/solid-bindings": "workspace:*",
    "@rtc/web-boot": "workspace:*",
    "@solidjs/web": "^2.0.3",
    "rxjs": "^7.8",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@rtc/client-core-rxjs": "workspace:*",
    "@rtc/devtools-app": "workspace:*",
    "@rtc/ui-contract": "workspace:*",
    "@rx-state/core": "^0.1.4",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-istanbul": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
