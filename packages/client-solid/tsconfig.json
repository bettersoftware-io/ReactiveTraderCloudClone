{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // "@ui-visual-shared" and "@ui-visual" are unused by anything under
    // `include` (src/ only) — they're here solely so knip's TypeScript path
    // resolution (which discovers this default tsconfig.json, not the extra
    // no-emit tsconfig.ui-visual.json) can resolve them for the visual
    // tier's harness files (the playwright host's `main.tsx` imports
    // `@ui-visual` directly; its render target imports `@ui-visual-shared`).
    // Mirrors client-react's tsconfig.json.
    "paths": {
      "#/*": ["./src/*"],
      "@ui-visual": ["./tests/ui/visual/solid"],
      "@ui-visual/*": ["./tests/ui/visual/solid/*"],
      "@ui-visual-shared": ["../ui-contract/src/visual"],
      "@ui-visual-shared/*": ["../ui-contract/src/visual/*"]
    }
  },
  "include": ["src"],
  // Co-located specs are excluded from this rootDir="src"-constrained
  // program: an increasing share of them import their page objects from
  // `#tests/ui/pages/**` (outside rootDir — TS6059), which this config's own
  // rootDir can never satisfy for both `src` app code AND `tests` page
  // modules at once. No `#tests/*` path mapping is declared here either —
  // with every `*.test.{ts,tsx}` excluded, nothing left in this program's
  // `include` needs it (do not add it back without re-including something
  // that does). tsconfig.ui-visual.json's pass in the same `pnpm typecheck`
  // chain re-type-checks all of `src` together with `tests` (incl. every
  // page module) in ONE program — adequate, and the authoritative program
  // for specs — but not a strict superset of this one (it narrows `types` to
  // `["node"]` and carries different project `references`). Mirrors
  // client-react's tsconfig.json trap fix exactly.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [
    { "path": "../domain" },
    { "path": "../client-core" },
    { "path": "../motion-core" },
    { "path": "../solid-bindings" }
  ]
}
