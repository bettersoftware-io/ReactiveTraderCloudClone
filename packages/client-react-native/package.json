{
  "name": "@rtc/client-react-native",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "imports": {
    "#/*": "./src/*",
    "#tests/*": "./tests/*",
    "#app/*": "./app/*"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "ios": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runIosDev.ts",
    "android": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runAndroidDev.ts",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runIosDev.ts",
    "native:regenerate:ios": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/regenerateNativeProject.ts ios",
    "native:regenerate:android": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/regenerateNativeProject.ts android",
    "dev:android": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runAndroidDev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests && jest",
    "test:coverage": "pnpm test:unit:coverage && pnpm test:native:coverage && node tests/coverage-merge/report.mts",
    "test:coverage:gate": "pnpm test:unit:coverage && pnpm test:native:coverage && node tests/coverage-merge/report.mts --min-lines=95",
    "test:unit:coverage": "vitest run --coverage",
    "test:native:coverage": "jest --coverage",
    "build": "tsc --noEmit",
    "export": "expo export --platform ios --output-dir dist",
    "eas-build-post-install": "pnpm -w exec turbo run build --filter=@rtc/client-react-native^...",
    "demo:ios:publish": "EXPO_PUBLIC_BUILD_COMMIT=$(git rev-parse --short HEAD) EXPO_PUBLIC_BUILD_TIME=$(date -u +%Y-%m-%dT%H:%MZ) pnpm dlx eas-cli@24.10.0 update --branch demo --platform ios --environment preview --message \"$(git rev-parse --abbrev-ref HEAD) @ $(git rev-parse --short HEAD)\" --non-interactive",
    "preview:android:build": "pnpm dlx eas-cli@24.10.0 build -p android --profile preview",
    "preview:android:run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/runAndroidBuild.ts",
    "smoke:ws": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/liveWsSmoke.ts",
    "test:rn:visual:simctl": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/simctl/run.ts",
    "test:rn:visual:simctl:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/simctl/run.ts --update",
    "test:rn:visual:maestro": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/maestro/run.ts",
    "test:rn:visual:maestro:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/maestro/run.ts --update",
    "test:rn:visual:maestro:android": "RTC_VISUAL_PLATFORM=android node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/maestro/run.ts",
    "test:rn:visual:maestro:android:update": "RTC_VISUAL_PLATFORM=android node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/maestro/run.ts --update",
    "test:rn:visual:reach": "jest tests/visual/reach --coverage --coverageProvider=babel --collectCoverageFrom='src/ui/**/*.tsx' --coverageReporters=json-summary --coverageDirectory=reports/native/visual-reach && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/visual/reach/report.ts",
    "clean": "rm -rf dist .turbo reports coverage .expo *.tsbuildinfo node_modules/.cache 2>/dev/null || true",
    "clean:deep": "pnpm run clean && (rm -rf node_modules ios android 2>/dev/null || true)"
  },
  "dependencies": {
    "@expo-google-fonts/chakra-petch": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rtc/client-adapters": "workspace:*",
    "@rtc/client-core-rxjs": "workspace:*",
    "@rtc/core-api": "workspace:*",
    "@rtc/core-logic": "workspace:*",
    "@rtc/devtools-core": "workspace:*",
    "@rtc/domain": "workspace:*",
    "@rtc/motion-core": "workspace:*",
    "@rtc/react-bindings": "workspace:*",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "^58.0.0",
    "expo-blur": "~58.0.5",
    "expo-constants": "^58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "^58.0.26",
    "expo-sensors": "~58.0.4",
    "expo-status-bar": "^58.0.4",
    "expo-updates": "~58.0.18",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "rxjs": "^7.8"
  },
  "devDependencies": {
    "@expo/fingerprint": "~0.21.6",
    "@jest/globals": "^30.0.0",
    "@react-native/jest-preset": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@rtc/devtools-relay": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~58.0.20",
    "jest": "^30.0.0",
    "jest-expo": "^58.0.12",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "test-renderer": "^1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
