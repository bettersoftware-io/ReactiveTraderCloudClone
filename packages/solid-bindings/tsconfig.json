{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "#/*": ["./src/*"] },
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../client-adapters" },
    { "path": "../client-core-rxjs" },
    { "path": "../core-api" },
    { "path": "../domain" }
  ],
  "include": ["src"]
}
