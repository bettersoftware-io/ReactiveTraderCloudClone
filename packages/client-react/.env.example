# WebSocket server base URL (leave unset for local simulator mode)
VITE_SERVER_URL=wss://your-server.example
# Local simulator-mode dev credentials as JSON (username -> password). These are
# the committed demo accounts (see CLAUDE.md "Demo accounts"); `pnpm dev` already
# reads them from the committed .env.development — this file is only needed to
# override them. For real deployed credentials, ask the team.
VITE_DEV_AUTH={"astark":"mcdc2026","nromanoff":"mcdc2026","tchalla":"mcdc2026","demo":"mcdc2026"}
# Production-build demo roster (hybrid mode when VITE_SERVER_URL is also set). The
# committed .env.production already carries the demo accounts; override here only
# to ship a different roster.
VITE_DEMO_AUTH={"demo":"mcdc2026"}
