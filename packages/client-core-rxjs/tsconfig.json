{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "paths": { "#/*": ["./src/*"] },
    "types": ["node"],
    // See domain/tsconfig.json — incremental cache lives in dist/ so the
    // sandbox's isolated-dist / shared-root split can't desync emit.
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "references": [
    // Tests only: the core's source takes its ports as arguments and imports
    // nothing from the adapters (dependency-cruiser `cores-take-ports-as-arguments`).
    { "path": "../client-core" },
    { "path": "../core-api" },
    { "path": "../core-logic" },
    { "path": "../core-contract" },
    { "path": "../domain" },
    { "path": "../shared" }
  ],
  "include": ["src"]
}
