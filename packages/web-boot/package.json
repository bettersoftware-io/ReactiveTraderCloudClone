{
  "name": "@rtc/web-boot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "tsc --build && tsc-alias -p tsconfig.json && node ../../scripts/check-dist.mts",
    "typecheck": "tsc --noEmit --tsBuildInfoFile .turbo/typecheck.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc-alias -w -p tsconfig.json & tsc --build --watch",
    "clean": "rm -rf dist .turbo *.tsbuildinfo reports coverage 2>/dev/null || true",
    "clean:deep": "pnpm run clean && (rm -rf node_modules 2>/dev/null || true)"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@rtc/boot-splash": "workspace:*",
    "@rtc/client-adapters": "workspace:*",
    "@rtc/client-core-async": "workspace:*",
    "@rtc/client-core-effect": "workspace:*",
    "@rtc/client-core-rxjs": "workspace:*",
    "@rtc/core-api": "workspace:*",
    "@rtc/core-logic": "workspace:*",
    "@rtc/devtools-core": "workspace:*",
    "@rtc/domain": "workspace:*",
    "@rx-state/core": "^0.1.4",
    "rxjs": "^7.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "jsdom": "^30.0.1",
    "tsc-alias": "1.9.7",
    "vitest": "^5.0.5"
  }
}
